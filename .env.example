# ============================================================
# MindBridge — Environment Variables Template
# Member 1: Infrastructure & Security
#
# INSTRUCTIONS:
#   1. Copy this file to .env  (never commit .env to git)
#   2. Fill in your values
#   3. In production (Cloud Run), these are set via Secret Manager
#      — do NOT use a .env file in production
# ============================================================

# ── GCP Project ──────────────────────────────────────────────
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# ── Vertex AI ────────────────────────────────────────────────
VERTEX_AI_MODEL=gemini-1.5-flash-001

# ── BigQuery ─────────────────────────────────────────────────
BIGQUERY_DATASET=mindbridge_insights
BIGQUERY_TABLE=distress_events

# ── Firebase / Firestore ─────────────────────────────────────
# LOCAL DEV: path to your downloaded service account key file
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# PRODUCTION: leave blank (Secret Manager injects FIREBASE_SERVICE_ACCOUNT_JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project ID (used for token verification)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://mindbridge.app,https://staging.mindbridge.app

# ── Environment ──────────────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development
