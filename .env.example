# ============================================================
# MindBridge — Environment Variables Template
# Source: Member 1 (infrastructure)
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your values
#   3. NEVER commit .env to git (it's in .gitignore)
#   4. In production (Cloud Run), set these via Secret Manager
#      and --set-env-vars in deploy.sh — do NOT use .env in prod
# ============================================================

# ── GCP Project ──────────────────────────────────────────────
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# ── Vertex AI ────────────────────────────────────────────────
VERTEX_AI_MODEL=gemini-1.5-flash-001

# ── BigQuery ─────────────────────────────────────────────────
BIGQUERY_DATASET=mindbridge_insights
BIGQUERY_TABLE=distress_events

# ── Firebase / Firestore ─────────────────────────────────────
# LOCAL DEV ONLY: path to downloaded service account key
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# PRODUCTION: injected from Secret Manager (leave blank locally unless testing prod flow)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project ID (same as GCP project ID in most setups)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Development: add http://localhost:3000 or http://localhost:5173
ALLOWED_ORIGINS=https://mindbridge.app,https://staging.mindbridge.app

# ── Environment ──────────────────────────────────────────────
# Options: development | staging | production
# "production" disables /docs, /redoc, /openapi.json
ENVIRONMENT=development
