# ---- MindBridge .dockerignore ----
# Secrets & credentials — NEVER in image
.env
.env.*
serviceAccountKey.json
**/serviceAccountKey.json
*.pem
*.key
*.p12
credentials/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Dev / test
.pytest_cache/
.coverage
htmlcov/
tests/
*.test.py

# IDE & OS
.idea/
.vscode/
*.DS_Store
.git/
.gitignore

# Docs (not needed in runtime image)
docs/
*.md
README*

# CI configs
cloudbuild.yaml
.github/
infra/
