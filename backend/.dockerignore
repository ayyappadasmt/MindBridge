# ============================================================
# MindBridge Backend — .dockerignore
# Restored from M1 original + integration additions
#
# Security fixes vs previous integration:
#   RESTORED: .env.* (all env file variants)
#   RESTORED: *.pem, *.key, *.p12 (certificate/key files)
#   RESTORED: credentials/ directory
#   RESTORED: cloudbuild.yaml (CI config not needed in runtime)
#   RESTORED: README* exclusion
#   KEPT: *.json wildcard from integration (broader coverage)
# ============================================================

# ── Secrets & credentials — NEVER in image ────────────────
.env
.env.*
*.json
serviceAccountKey*
*ServiceAccount*
*credentials*
firebase*.json
credentials/
*.pem
*.key
*.p12

# ── Python artifacts ──────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────
.venv/
venv/
env/

# ── Tests ─────────────────────────────────────────────────
tests/
.pytest_cache/
.coverage
htmlcov/
*.test.py

# ── Git ───────────────────────────────────────────────────
.git/
.gitignore

# ── Docs & infra (not needed in runtime image) ────────────
docs/
infra/
*.md
README*

# ── CI configs ────────────────────────────────────────────
cloudbuild.yaml
.github/

# ── IDE & OS ──────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
*.swp
*.swo
