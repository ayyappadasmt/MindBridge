# ============================================================
# MindBridge Backend — Environment Variables
# Source: Member 1 (infrastructure) + Frontend integration
#
# INSTRUCTIONS:
#   1. Copy: cp .env.example .env
#   2. Fill in your values
#   3. NEVER commit .env to git
#   4. Production: set via Secret Manager / Cloud Run --set-env-vars
# ============================================================

# ── GCP Project ───────────────────────────────────────────
PROJECT_ID=mindbridge-495813
REGION=us-central1

# ── Vertex AI ─────────────────────────────────────────────
VERTEX_AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=AQ.Ab8RN6I8Q38Ny-a4CjKXkW63N0XqpJ8V-Y0d8vGkhMNqJl2OpQ
# ── BigQuery ──────────────────────────────────────────────
BIGQUERY_DATASET=mindbridge_insights
BIGQUERY_TABLE=distress_events

# ── Firebase / Firestore ──────────────────────────────────
# LOCAL DEV: path to downloaded service account key (never commit this file)
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
# PRODUCTION: JSON string injected from Secret Manager
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase project ID (matches GCP project in most setups)
FIREBASE_PROJECT_ID=mindbridge-495813


# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# DEVELOPMENT: include localhost ports used by Vite dev server
# PRODUCTION: replace localhost entries with your deployed frontend URL
ALLOWED_ORIGINS=https://mindbridge.app,https://staging.mindbridge.app,http://localhost:5173,http://localhost:4173

# ── Environment ───────────────────────────────────────────
# "development" enables /docs, /redoc, /openapi.json
# "production"  disables them
ENVIRONMENT=development

